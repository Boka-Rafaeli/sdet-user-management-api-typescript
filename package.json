{
  "name": "sdet-user-management-api-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test": "tsx scripts/verify.ts",
    "verify": "npm test",
    "api:start": "tsx scripts/api.ts start",
    "api:stop": "tsx scripts/api.ts stop",
    "api:wait": "tsx scripts/api.ts wait",
    "test:infrastructure": "tsx --test tests/infrastructure/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "yaml": "2.9.1"
  }
}
